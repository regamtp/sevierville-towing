{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sevierville-towing",
  "compatibility_date": "2026-08-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
